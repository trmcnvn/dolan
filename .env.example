# Runtime Worker binding, used by Alchemy deploy/dev.
DISCORD_PUBLIC_KEY=

# Optional ping response. Defaults to the old grey-question fallback.
PING_EMOJI=<:grey_question:582795707401109506>

# Command registration script only.
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

# Optional: register commands to one guild for immediate testing.
# Omit to register global commands.
DISCORD_GUILD_ID=
